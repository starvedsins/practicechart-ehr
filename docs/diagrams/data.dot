digraph Data{graph[label="PracticeChart data relationships",labelloc=t,rankdir=LR];node[shape=record,fontname="Arial",fontsize=11];users[label="users|id PK|username UNIQUE|role and password hash"];patients[label="patients|id PK|mrn UNIQUE|demographics and version"];appointments[label="appointments|id PK|patient_id FK|doctor_id FK|start_at and end_at|overlap exclusions"];visits[label="visits|id PK|patient_id FK|doctor_id FK|appointment_id FK UNIQUE|revision and status"];revisions[label="clinical_revisions|id PK|visit_id FK|author_id FK|revision UNIQUE per visit|content JSONB and state"];prescriptions[label="prescriptions|revision_id FK|visit_id FK|patient_id FK|doctor-entered content"];documents[label="documents|id PK|patient_id FK|replaces_id FK|private path and SHA256"];invoices[label="invoices|id PK|number UNIQUE|patient_id FK|lines and integer cents"];audit[label="audit_events|id PK|actor_id FK|action and record reference"];sessions[label="sessions|token hash PK|user_id FK|expiry"];users->sessions[label="1 to many"];patients->appointments[label="1 to many"];users->appointments[label="doctor"];patients->visits[label="1 to many"];appointments->visits[label="0 or 1"];users->visits[label="doctor"];visits->revisions[label="1 to many"];revisions->prescriptions[label="0 to many"];patients->documents[label="1 to many"];patients->invoices[label="1 to many"];users->audit[label="actor"];}