digraph Swimlane{graph[label="Visit workflow by role",labelloc=t,rankdir=LR];node[shape=box,fontname="Arial"];subgraph cluster_desk{label="Front desk";register[label="Register or find patient"];arrival[label="Mark arrival and start visit"];file[label="File ready visit"];invoice[label="Create invoice or attendance slip"];}subgraph cluster_doctor{label="Doctor";review[label="Review patient history"];record[label="Enter notes, diagnosis, and treatment"];final[label="Save final clinical revision"];}subgraph cluster_system{label="System and PostgreSQL";guard[label="Require final diagnosis"];log[label="Commit filed state and audit"];}register->arrival;arrival->review;review->record;record->final;final->guard;guard->file[label="ready state only"];file->log;log->invoice;}