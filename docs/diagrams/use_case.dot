graph UseCases{graph[label="PracticeChart role use cases",labelloc=t,rankdir=LR];node[fontname="Arial",fontsize=12];desk[shape=plaintext,label="Receptionist"];doctor[shape=plaintext,label="Doctor"];subgraph cluster_system{label="PracticeChart EHR";node[shape=ellipse];login[label="Log in / log out"];patient[label="Register and update patient"];find[label="Find patient / interim record"];schedule[label="Manage appointments"];schedreport[label="Print schedule"];file[label="Start and file ready visit"];invoice[label="Create manual invoice"];upload[label="Upload medical documents"];counts[label="Review visit counts"];clinical[label="Record and correct care"];lab[label="Enter lab results"];report[label="Print clinical reports"];retrieve[label="Retrieve diagnostic report"];prescription[label="Create prescription"];certificate[label="Create medical certificate"];}desk--{login patient find schedule schedreport file invoice upload counts};doctor--{login clinical lab report retrieve prescription certificate};}