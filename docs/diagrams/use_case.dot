graph UseCases{graph[label="PracticeChart use cases",labelloc=t,rankdir=LR];node[fontname="Arial",fontsize=12];desk[shape=plaintext,label="Front desk"];doctor[shape=plaintext,label="Doctor"];subgraph cluster_system{label="PracticeChart EHR";node[shape=ellipse];login[label="Log in"];patient[label="Register and update patient"];schedule[label="Manage appointment"];file[label="File completed visit"];invoice[label="Create manual invoice"];clinical[label="Record and correct care"];lab[label="Store and retrieve lab report"];report[label="Print clinical patient report"];accounts[label="Manage staff access"];audit[label="View audit history"];}desk--login;desk--patient;desk--schedule;desk--file;desk--invoice;doctor--login;doctor--patient;doctor--schedule;doctor--file;doctor--invoice;doctor--clinical;doctor--lab;doctor--report;doctor--accounts;doctor--audit;}