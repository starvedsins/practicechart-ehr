digraph DFD{graph[label="Level 1 data flow",labelloc=t,rankdir=LR];node[shape=box,fontname="Arial"];staff[label="Staff"];auth[label="1 Authenticate",shape=ellipse];patient[label="2 Manage patient",shape=ellipse];booking[label="3 Manage appointment",shape=ellipse];care[label="4 Record and retrieve care",shape=ellipse];report[label="5 Produce report",shape=ellipse];database[label="EHR PostgreSQL",shape=cylinder];blob[label="Private diagnostic storage",shape=cylinder];staff->auth[label="credentials"];auth->patient[label="server identity"];auth->booking[label="server identity"];auth->care[label="doctor identity"];patient->database[label="demographics"];booking->database[label="booking and audit"];care->database[label="clinical revisions"];care->blob[label="private document bytes"];database->report[label="authorised records"];blob->report[label="authorised document"];report->staff[label="reading or print output"];publicPatient[label="Patient"];intake[label="6 Submit and review intake",shape=ellipse];mail[label="7 Process appointment mail",shape=ellipse];provider[label="Email notification provider"];publicPatient->intake[label="form and consent"];intake->publicPatient[label="reference only"];staff->intake[label="receptionist review"];intake->database[label="pending form or accepted registration"];database->mail[label="queued booking IDs"];mail->provider[label="appointment time, no clinical text"];provider->mail[label="acceptance or failure"];mail->database[label="queue status"]; }