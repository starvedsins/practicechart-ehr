digraph Modules{graph[label="Input processing and output modules",labelloc=t,rankdir=TB];node[shape=box,fontname="Arial",style=filled,fillcolor="#f3f6fa"];ehr[label="PracticeChart EHR"];input[label="INPUT"];process[label="PROCESSING"];output[label="OUTPUT"];ehr->{input process output};credentials[label="User credentials"];demographics[label="Patient demographics"];requests[label="Appointment requests"];files[label="Diagnostic files"];clinicalInput[label="Doctor clinical entries"];input->{credentials demographics requests files clinicalInput};auth[label="Authentication and role checks"];patient[label="Patient management"];appointment[label="Appointment transactions"];care[label="Clinical revisions and filing"];billing[label="Invoice calculation"];recovery[label="Backup and recovery"];process->{auth patient appointment care billing recovery};docs[label="Clinical documents and patient history"];admin[label="Schedules, attendance, and invoices"];audit[label="Audit history and recovery evidence"];output->{docs admin audit};}