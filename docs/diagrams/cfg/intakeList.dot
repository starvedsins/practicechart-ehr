digraph intakeList { graph [label="intakeList",labelloc=t,rankdir=TB,bgcolor="white"];node [fontname="Arial",fontsize=10,style=filled,fillcolor="#f5f7fb",color="#8c9bb4"];edge [fontname="Arial",fontsize=9,color="#63748d"];n1[shape=oval,label="1: START"];
n2[shape=oval,label="2: END"];
n3[shape=box,label="3: await requireRole(actor, \"front_desk\");"];
n4[shape=box,label="4: BEGIN transaction"];
n5[shape=box,label="5: COMMIT transaction"];
n6[shape=box,label="6: await event(tx, actor, \"view\", \"registrati\non_intakes\");"];
n7[shape=box,label="7: RETURN rows( sql`SELECT id,payload,status,\nversion,created_at FROM registration_intak\nes WHERE status='pending' ORDER BY created\n_at LIMIT 100`, tx, )"];n1->n3[label=""];
n3->n4[label=""];
n4->n6[label=""];
n6->n7[label=""];
n7->n5[label=""];
n5->n2[label="Return"];}