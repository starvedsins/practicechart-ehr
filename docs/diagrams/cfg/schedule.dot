digraph schedule { graph [label="schedule",labelloc=t,rankdir=TB,bgcolor="white"];node [fontname="Arial",fontsize=10,style=filled,fillcolor="#f5f7fb",color="#8c9bb4"];edge [fontname="Arial",fontsize=9,color="#63748d"];n1[shape=oval,label="1: START"];
n2[shape=oval,label="2: END"];
n3[shape=diamond,label="3: date"];
n4[shape=diamond,label="4: /^\\d{4}-\\d{2}-\\d{2}$/.test(date)"];
n5[shape=box,label="5: const day = date && /^\\d{4}-\\d{2}-\\d{2}$/.\ntest(date) ? date : new Intl.DateTimeForma\nt(\"en-CA\", { timeZone: \"America/Jamaica\", \n}).format(new Date());"];
n6[shape=box,label="6: BEGIN transaction"];
n7[shape=box,label="7: COMMIT transaction"];
n8[shape=box,label="8: await event(tx, actor, \"view\", \"schedule\")\n;"];
n9[shape=box,label="9: RETURN rows( sql`SELECT a.*,p.mrn,p.first_\nname,p.last_name,u.name AS doctor_name FRO\nM appointments a JOIN patients p ON p.id=a\n.patient_id JOIN users u"];
n10[shape=box,label="10: Follow False branch"];n1->n3[label=""];
n3->n4[label="True"];
n4->n5[label="True"];
n3->n5[label="False"];
n4->n10[label="False"];
