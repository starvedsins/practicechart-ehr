n10[shape=box,label="10: const list = await rows( sql`SELECT * FROM\n patients WHERE id IN(${id}::uuid,${target\nId}::uuid) ORDER BY id FOR UPDATE`, tx, );\n"];
n11[shape=diamond,label="11: list.length !== 2"];
n12[shape=box,label="12: RAISE new AppError(404, \"Both patients mus\nt exist.\")"];
n13[shape=box,label="13: const source = list.find((p) => p.id === i\nd);"];
n14[shape=box,label="14: const target = list.find((p) => p.id === t\nargetId);"];
n15[shape=diamond,label="15: source?.provisional_reason"];
n16[shape=diamond,label="16: source.merged_into"];
n17[shape=diamond,label="17: target?.merged_into"];
n18[shape=box,label="18: RAISE new AppError( 400, \"Use an unresolve\nd provisional record and an active primary\n record.\", )"];
n19[shape=box,label="19: await tx .update(patients) .set({ mergedIn\nto: targetId, archived: true, version: Num\nber(source.version) + 1, }) .where(eq(pati\nents.id, id));"];
n20[shape=box,label="20: await event(tx, actor, \"reconcile\", \"patie\nnt\", id, { targetId, reason });"];
