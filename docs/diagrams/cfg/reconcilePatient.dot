n4[shape=box,label="4: const { targetId, reason } = z .object({ t\nargetId: idSchema, reason: z.string().trim\n().min(3).max(500) }) .parse(input);"];
n5[shape=box,label="5: idSchema.parse(id);"];
n6[shape=diamond,label="6: id === targetId"];
