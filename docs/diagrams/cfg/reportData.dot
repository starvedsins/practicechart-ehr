n11[shape=box,label="11: RETURN { type, counts: await rows( sql`SEL\nECT (visit_at AT TIME ZONE 'America/Jamaic\na')::date AS day,count(*) AS visits,count(\n*) FILTER(WHERE status='"];
n12[shape=box,label="12: idSchema.parse(id);"];
n13[shape=box,label="13: await event(db, actor, \"export\", type, id)\n;"];
n14[shape=diamond,label="14: type === \"invoice\""];
n15[shape=box,label="15: RETURN { type, invoice: await found( await\n rows( sql`SELECT i.*,p.first_name,p.last_\nname,p.mrn,p.address FROM invoices i JOIN \npatients p ON p.id=i.pat"];
n16[shape=diamond,label="16: type === \"history\""];
