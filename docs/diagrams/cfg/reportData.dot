n18[shape=box,label="18: const v = await found( await rows( sql`SEL\nECT v.*,p.first_name,p.last_name,p.mrn,u.n\name AS doctor_name FROM visits v JOIN pati\nents p ON p.id=v.patient"];
n19[shape=diamond,label="19: type === \"attendance\""];
n20[shape=box,label="20: RETURN { type, visit: { id: v.id, mrn: v.m\nrn, first_name: v.first_name, last_name: v\n.last_name, visit_at: v.visit_at, doctor_n\name: v.doctor_name, stat"];
n21[shape=box,label="21: const c = await found( await rows( sql`SEL\nECT content,state,revision,created_at FROM\n clinical_revisions WHERE visit_id=${id}::\nuuid ORDER BY revision D"];
n22[shape=diamond,label="22: c.state !== \"final\""];
